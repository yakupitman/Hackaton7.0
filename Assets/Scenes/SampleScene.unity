  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Guidelines
  panel: {fileID: 794073357}
  stepText: {fileID: 1457421200}
  skipButton: {fileID: 1966003630}
  stepTexts:
  - Buy your first Chisel Kit in the Store.
  - Buy 3 of the cheapest Bait.
  - Go to the right corner of the room and unlock the first Pond.
  - Pick a Bait and start fishing.
  - Catch it! Keep the needle inside the moving area.
  - Carry the Prey to the Lift and send it up to sell it.
  - Leave through the main door and run down the corridor.
  hintText: Didn't make it? Try to lighten that heavy thing. Have fun!
  hintDuration: 15
  baitGoal: 3
  fadeDuration: 0.25
  store: {fileID: 1645238973}
  mainMenu: {fileID: 778393951}
  escapeSequence: {fileID: 1023255097}
